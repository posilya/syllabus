{{> main/head }}

<h1>Расписание преподавателя {{teacher.last_name}} {{teacher.first_name}} {{teacher.patronymic}}</h1>
<p><i>тест)</i></p>

<table>
    <thead>
        <tr>
            <th>id</th>
            <th>Дата</th>
            <th>Время</th>
            <th>Аудитория</th>
            <th>Группа</th>
        </tr>
    </thead>
    <tbody>
        {{#each schedule}}
            <tr>
                <th>{{this.lesson_schedule_id}}</th>
                <td>{{this.lesson_date}}</td>
                <td>{{#if this.time_start}}{{this.time_start}}&nbsp;&mdash; {{this.time_end}}{{else}}<i>время не указано</i>{{/if}}</td>
                <td>{{#if this.auditorium_id}}{{this.auditorium_number}} ({{this.auditorium_floor}} этаж, id {{this.auditorium_id}}){{/if}}</td>
                <td>{{#if this.group_id}}{{this.group_name}} (id {{this.group_id}}){{/if}}</td>
            </tr>
        {{/each}}
    </tbody>
</table>

{{> main/footer }}
